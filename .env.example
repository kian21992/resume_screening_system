APP_ENV=development
# Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=sqlite:///resume_screening.db
UPLOAD_FOLDER=instance/uploads
DISPLAY_TIMEZONE=Asia/Manila
FLASK_DEBUG=1
# Device isolation uses a signed, persistent browser session cookie.
DEVICE_COOKIE_DAYS=3650
# Use a shared backend such as redis://localhost:6379 in multi-worker production.
RATELIMIT_STORAGE_URI=memory://
# Required by the production bootstrap command. Do not use example passwords.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
# Optional production role accounts. Usernames default to it_manager and hr_admin.
INITIAL_MANAGER_USERNAME=it_manager
INITIAL_MANAGER_PASSWORD=
INITIAL_HR_USERNAME=hr_admin
INITIAL_HR_PASSWORD=
